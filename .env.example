# Anthropic LLM
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# VolcEngine / BytePlus Ark API key—used by the Seedance MCP sidecar as ARK_API_KEY
FAL_KEY=your_byteplus_ark_api_key_here

# Slack Configuration
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_APP_TOKEN=your_slack_app_token_here

# Allow all Slack workspace users to chat with the agent
GATEWAY_ALLOW_ALL_USERS=true
